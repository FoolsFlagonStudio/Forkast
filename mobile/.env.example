# Copy to .env.local (git-ignored) and point at the Spring Boot backend.
# On a real phone, "localhost" is the phone itself - use your computer's LAN IP
# (Windows: run `ipconfig`, look for IPv4 Address), e.g. http://192.168.1.42:8080
EXPO_PUBLIC_API_URL=http://192.168.1.42:8080

# Meal plans come from the backend. Set to 1 to simulate them on the device instead
# (UI work without the generator; no sides, pantry staples or auto-planning).
EXPO_PUBLIC_MOCK_PLANS=0

# Run the whole app on sample data, no backend needed (any login works).
# EXPO_PUBLIC_DEMO=1
