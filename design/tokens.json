{
  "$description": "Victual design tokens. Single source of truth for the website (frontend/) and the app (mobile/). Edit this file, then run `node design/build-tokens.mjs` to regenerate both apps' tokens.ts.",
  "palette": {
    "backgroundLight": "#F7F2EE",
    "backgroundDark": "#3C3C3C",
    "mauve": "#C59DB0",
    "plum": "#3D2433",
    "sage": "#9BC59D",
    "forest": "#1F3326",
    "black": "#000000",
    "white": "#FFFFFF"
  },
  "$colorsNote": "Light roles confirmed from the auth and onboarding screens. Dark roles and 'danger' are still provisional - no dark or error designs yet.",
  "colors": {
    "light": {
      "background": "backgroundLight",
      "surface": "white",
      "text": "black",
      "textStrong": "black",
      "muted": "#8E8A87",
      "primary": "sage",
      "onPrimary": "black",
      "accent": "sage",
      "onAccent": "forest",
      "secondary": "mauve",
      "onSecondary": "plum",
      "highlight": "plum",
      "brandSurface": "forest",
      "onBrandSurface": "backgroundLight",
      "border": "#D9D2CC",
      "divider": "#A9A5A2",
      "danger": "#B3261E",
      "heading": "#444444",
      "subtle": "#5A5A59",
      "primaryDisabled": "#CDD4CD",
      "onPrimaryDisabled": "backgroundLight",
      "selected": "forest",
      "onSelected": "backgroundLight",
      "progressLine": "mauve"
    },
    "dark": {
      "background": "backgroundDark",
      "surface": "#474747",
      "text": "backgroundLight",
      "textStrong": "white",
      "muted": "#B3ADA8",
      "primary": "sage",
      "onPrimary": "forest",
      "accent": "mauve",
      "onAccent": "plum",
      "secondary": "mauve",
      "onSecondary": "plum",
      "highlight": "mauve",
      "brandSurface": "forest",
      "onBrandSurface": "backgroundLight",
      "border": "#5A5A5A",
      "divider": "#7A7672",
      "danger": "#F2B8B5",
      "heading": "backgroundLight",
      "subtle": "#C9C3BE",
      "primaryDisabled": "#5E655E",
      "onPrimaryDisabled": "#A3AAA3",
      "selected": "backgroundLight",
      "onSelected": "forest",
      "progressLine": "mauve"
    }
  },
  "fonts": {
    "brand": "DM Sans",
    "ui": "Poppins"
  },
  "typography": {
    "brand": {
      "font": "brand",
      "weight": 600,
      "size": 32,
      "lineHeight": 40
    },
    "h1": {
      "font": "ui",
      "weight": 700,
      "size": 32,
      "lineHeight": 40
    },
    "h2": {
      "font": "ui",
      "weight": 600,
      "size": 28,
      "lineHeight": 36
    },
    "h3": {
      "font": "ui",
      "weight": 500,
      "size": 20,
      "lineHeight": 28
    },
    "body": {
      "font": "ui",
      "weight": 400,
      "size": 16,
      "lineHeight": 24
    },
    "small": {
      "font": "ui",
      "weight": 300,
      "size": 12,
      "lineHeight": 18
    },
    "caption": {
      "font": "ui",
      "weight": 700,
      "size": 12,
      "lineHeight": 16
    },
    "button": {
      "font": "ui",
      "weight": 500,
      "size": 12,
      "lineHeight": 16,
      "letterSpacing": 1.5
    },
    "input": {
      "font": "ui",
      "weight": 400,
      "size": 12,
      "lineHeight": 18,
      "letterSpacing": 0.5
    },
    "bodySmall": {
      "font": "ui",
      "weight": 400,
      "size": 12,
      "lineHeight": 18
    },
    "social": {
      "font": "ui",
      "weight": 500,
      "size": 15,
      "lineHeight": 20
    },
    "fine": {
      "font": "ui",
      "weight": 400,
      "size": 11,
      "lineHeight": 14
    },
    "display": {
      "font": "ui",
      "weight": 600,
      "size": 140,
      "lineHeight": 150
    },
    "title": {
      "font": "ui",
      "weight": 400,
      "size": 32,
      "lineHeight": 38
    },
    "lead": {
      "font": "ui",
      "weight": 300,
      "size": 17,
      "lineHeight": 22
    },
    "option": {
      "font": "ui",
      "weight": 400,
      "size": 16,
      "lineHeight": 22
    },
    "label": {
      "font": "ui",
      "weight": 400,
      "size": 14,
      "lineHeight": 20
    },
    "field": {
      "font": "ui",
      "weight": 400,
      "size": 18,
      "lineHeight": 24,
      "letterSpacing": 0.5
    },
    "buttonLarge": {
      "font": "ui",
      "weight": 500,
      "size": 14,
      "lineHeight": 18,
      "letterSpacing": 2
    }
  },
  "$layoutNote": "Spacing and radii are provisional (4px grid) until screen designs confirm them.",
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "$typographyNote": "brand..caption come from the Figma type sheet. The rest were measured from the auth and onboarding screens (fine is 11pt - the designs use ~9pt, below Apple's 11pt minimum)."
}
