{
  "$description": "Victual design tokens. Single source of truth for the website (frontend/) and the app (mobile/). Edit this file, then run `node design/build-tokens.mjs` to regenerate both apps' tokens.ts.",

  "palette": {
    "backgroundLight": "#F7F2EE",
    "backgroundDark": "#3C3C3C",
    "mauve": "#C59DB0",
    "plum": "#3D2433",
    "sage": "#9BC59D",
    "forest": "#1F3326",
    "black": "#000000",
    "white": "#FFFFFF"
  },

  "$colorsNote": "Semantic roles below are PROVISIONAL - inferred from the logo usage, not from screen designs. Adjust once the auth screens come in.",
  "colors": {
    "light": {
      "background": "backgroundLight",
      "surface": "white",
      "text": "backgroundDark",
      "textStrong": "forest",
      "primary": "forest",
      "onPrimary": "backgroundLight",
      "accent": "sage",
      "onAccent": "forest",
      "secondary": "mauve",
      "onSecondary": "plum",
      "highlight": "plum",
      "border": "#D9D2CC",
      "muted": "#7A7470"
    },
    "dark": {
      "background": "backgroundDark",
      "surface": "#474747",
      "text": "backgroundLight",
      "textStrong": "white",
      "primary": "sage",
      "onPrimary": "forest",
      "accent": "mauve",
      "onAccent": "plum",
      "secondary": "mauve",
      "onSecondary": "plum",
      "highlight": "mauve",
      "border": "#5A5A5A",
      "muted": "#B3ADA8"
    }
  },

  "fonts": {
    "brand": "DM Sans",
    "ui": "Poppins"
  },

  "typography": {
    "brand":   { "font": "brand", "weight": 600, "size": 32, "lineHeight": 40 },
    "h1":      { "font": "ui", "weight": 700, "size": 32, "lineHeight": 40 },
    "h2":      { "font": "ui", "weight": 600, "size": 28, "lineHeight": 36 },
    "h3":      { "font": "ui", "weight": 500, "size": 20, "lineHeight": 28 },
    "body":    { "font": "ui", "weight": 400, "size": 16, "lineHeight": 24 },
    "small":   { "font": "ui", "weight": 300, "size": 12, "lineHeight": 18 },
    "caption": { "font": "ui", "weight": 700, "size": 12, "lineHeight": 16 }
  },

  "$layoutNote": "Spacing and radii are provisional (4px grid) until screen designs confirm them.",
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 }
}
